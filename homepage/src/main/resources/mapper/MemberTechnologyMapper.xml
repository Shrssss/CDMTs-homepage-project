<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper.MemberTechnologyMapper">

	<select id="findByTechnologiesByMemberIds" parameterType="java.util.List" resultType="net.codemates.homepage.model.entity.MemberTechnology">
	
		SELECT *
		FROM member_technologis
		WHERE member_id IN
		
		<foreach collection="memberIds" item="memberId" open="(" separator="," close=")">
		
			#{memeberId}
		
		</foreach>
	
	</select>
	
	<select id="findByMembersByTechnologyIds" parameterType="java.util.List" resultType="net.codemates.homepage.model.entity.MemberTechnology">
	
		SELECT *
		FROM member_technologis
		WHERE technology_id IN
		
		<foreach collection="technologyIds" item="technologyId" open="(" separator="," close=")">
		
			#{technologyId}
		
		</foreach>
	
	</select>


	
	<insert id="insert" parameterType="net.codemates.homepage.model.entity.MemberTechnology">
	
		INSERT INTO 
		member_technologis
		(
			member_id,
			technology_id
		)
		VALUES
		(
			#{memberId},
			#{technologyId}
		)
	
	</insert>
	
	
	
	<delete id="delete" parameterType="Long">
	
		DELETE FROM items WHERE member_id = #{memberId} AND technology_id = #{technologyId}
	
	</delete>

</mapper>